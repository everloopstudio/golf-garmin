# Copia a .env (local) o define estas variables en Dokploy > Environment. NO subas .env al repo.
# PIN de acceso a la web (4-8 digitos)
APP_PIN=
# Token que envia el reloj en la cabecera X-Device-Token. Genera: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
DEVICE_TOKEN=
# Clave para firmar la cookie de sesion. Genera: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
SECRET_KEY=
# En local sin HTTPS pon false; en produccion deja true
COOKIE_SECURE=true
