# Copia a .env (local) o define estas variables en Dokploy > Environment. NO subas .env al repo.
# PIN de acceso a la web (4-8 digitos)
APP_PIN=
# Token que envia el reloj en la cabecera X-Device-Token. Genera: openssl rand -hex 32
DEVICE_TOKEN=
# Clave para firmar la cookie de sesion. Genera: openssl rand -hex 32
SECRET_KEY=
# En local sin HTTPS pon false; en produccion deja true
COOKIE_SECURE=true
